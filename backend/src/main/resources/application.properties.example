# ============================================================
# FinPilot — Application Configuration EXAMPLE
# ============================================================
# Copy this file to application.properties and fill in your
# actual values. application.properties is gitignored.
# ============================================================

# Application
spring.application.name=finpilot

# ── Database ─────────────────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/expenseiq
spring.datasource.username=root
spring.datasource.password=Rushibhoir@123

# ── JPA / Hibernate ──────────────────────────────────────────
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false

# ── JWT ──────────────────────────────────────────────────────
# Use a strong random secret in production (min 32 characters)
app.jwt.secret=YOUR_STRONG_JWT_SECRET_KEY_MIN_32_CHARS
app.jwt.expiration-ms=3600000

# ── OpenRouter AI ────────────────────────────────────────────
# Get your API key from https://openrouter.ai/keys
openrouter.api.key=YOUR_OPENROUTER_API_KEY
openrouter.base-url=https://openrouter.ai/api/v1
openrouter.model=google/gemini-2.5-flash
openrouter.max-tokens.ocr=2048
openrouter.max-tokens.insights=2048

